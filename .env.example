BASE_PATH=/opt/data
ARCHIVE_ZIP_PATH=/zip/archive
FILE_ARCHIVE_PATH=/files/archive

# ZIP filenames must match NiFi Expression Language regex syntax.
# This default means: contains a dot, contains TESTZIP, contains another dot,
# and ends with .zip.
ZIP_NAME_REGEX=^.*\..*TESTZIP.*\..*\.zip$

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=file_ingestion
POSTGRES_USER=nifi
POSTGRES_PASSWORD=change_me

