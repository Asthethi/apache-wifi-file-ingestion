{
  "flowEncodingVersion": "1.0",
  "nifiVersion": "2.5.0",
  "snapshotMetadata": {
    "author": "Codex",
    "comments": "Single process group for ZIP file ingestion, archival, extraction, and PostgreSQL metadata tracking.",
    "timestamp": 1782777600000
  },
  "flowContents": {
    "identifier": "43badacf-b3f6-4785-b124-97cd2d58da8f",
    "name": "ZIP File Ingestion",
    "comments": "Imports as one process group. Configure and enable the DBCPConnectionPool controller service after import.",
    "position": {
      "x": 0,
      "y": 0
    },
    "controllerServices": [
      {
        "identifier": "13822df0-736a-42bb-972c-ff5cf59ce3e2",
        "name": "PostgreSQL DBCP Connection Pool",
        "type": "org.apache.nifi.dbcp.DBCPConnectionPool",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-dbcp-service-nar",
          "version": "2.5.0"
        },
        "comments": "Requires PostgreSQL JDBC driver configured in NiFi.",
        "properties": {
          "Database Connection URL": "jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}",
          "Database Driver Class Name": "org.postgresql.Driver",
          "Database User": "${POSTGRES_USER}",
          "Password": "${POSTGRES_PASSWORD}",
          "Max Wait Time": "30 sec",
          "Max Total Connections": "8"
        }
      }
    ],
    "processors": [
      {
        "identifier": "9fba7e44-4583-4c6a-bfc8-48a8c3662f0e",
        "name": "List Incoming ZIP Files",
        "type": "org.apache.nifi.processors.standard.ListFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.5.0"
        },
        "position": {
          "x": 0,
          "y": 0
        },
        "schedulingPeriod": "30 sec",
        "schedulingStrategy": "TIMER_DRIVEN",
        "properties": {
          "Input Directory": "${BASE_PATH}",
          "File Filter": ".*\\.zip",
          "Recurse Subdirectories": "false",
          "Minimum File Age": "0 sec",
          "Ignore Hidden Files": "true"
        },
        "autoTerminatedRelationships": [
          "failure"
        ]
      },
      {
        "identifier": "70b4bd57-bb45-4205-ba0c-996f1fe5a3c3",
        "name": "Set Parent ZIP Attributes",
        "type": "org.apache.nifi.processors.attributes.UpdateAttribute",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-update-attribute-nar",
          "version": "2.5.0"
        },
        "position": {
          "x": 320,
          "y": 0
        },
        "properties": {
          "zip.id": "${UUID()}",
          "parent.id": "${zip.id}",
          "parent.zip.name": "${filename}",
          "file.extension": "${filename:substringAfterLast('.')}",
          "source.file.path": "${absolute.path}/${filename}"
        }
      },
      {
        "identifier": "b3004e8c-fe28-423c-8799-510fc8447c31",
        "name": "Insert Parent SUBMITTED",
        "type": "org.apache.nifi.processors.standard.PutSQL",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.5.0"
        },
        "position": {
          "x": 640,
          "y": 0
        },
        "properties": {
          "JDBC Connection Pool": "13822df0-736a-42bb-972c-ff5cf59ce3e2",
          "SQL Statement": "INSERT INTO file_metadata (id, name, extension, file_size, submitted_at, file_status, parent_zip_name, parent_id) VALUES ('${zip.id}'::uuid, $$${filename}$$, $$${file.extension}$$, ${fileSize}, now(), 'SUBMITTED', $$${filename}$$, NULL);",
          "Support Fragmented Transactions": "false",
          "Obtain Generated Keys": "false"
        },
        "autoTerminatedRelationships": [
          "retry"
        ]
      },
      {
        "identifier": "69e88ae6-4744-41b7-93c5-70b510d67b5d",
        "name": "Fetch And Archive ZIP",
        "type": "org.apache.nifi.processors.standard.FetchFile",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.5.0"
        },
        "position": {
          "x": 960,
          "y": 0
        },
        "properties": {
          "File to Fetch": "${source.file.path}",
          "Completion Strategy": "Move File",
          "Move Destination Directory": "${BASE_PATH}${ARCHIVE_ZIP_PATH}",
          "Move Conflict Strategy": "Fail",
          "Log level when file not found": "ERROR"
        }
      },
      {
        "identifier": "f0535966-e604-44a7-8917-2011e5424292",
        "name": "Update Parent ARCHIVED",
        "type": "org.apache.nifi.processors.standard.PutSQL",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "2.5.0"
        },
        "position": {
          "x": 1280,
          "y": 0
        },
        "properties": {
          "JDBC Connection Pool": "13822df0-736a-42bb-972c-ff5cf59ce3e2",
          "SQL Statement": "UPDATE file_metadata SET file_status = 'ARCHIVED' WHERE id = '${zip.id}'::uuid;",
          "Support Fragmented Transactions": "false",
          "Obtain Generated Keys": "false"
        },
        "autoTerminatedRelationships": [
          "retry"
        ]
      },
      {
        "identifier": "d69c521e-bddd-4a38-aa0b-63a5cfe531c4",
        "name": "Validate ZIP Filename",
        "type": "org.apache.nifi.processors.standard.RouteOnAttribute",
